    // ---- Color system: unique per staff member, generated via the golden
    // angle so colors stay well-separated regardless of staff count ----
    private (string Accent, string Bg, string Fg) ChipColorFor(Guid staffId)
    {
        var index = _staffColorIndex.TryGetValue(staffId, out var i) ? i : 0;
        var hue = (index * 137.508) % 360.0;
        return (HslToHex(hue, 0.62, 0.42), HslToHex(hue, 0.55, 0.93), HslToHex(hue, 0.55, 0.28));
    }

    private static string HslToHex(double h, double s, double l)
    {
        double C = (1 - Math.Abs(2 * l - 1)) * s;
        double X = C * (1 - Math.Abs((h / 60.0 % 2) - 1));
        double m = l - C / 2;
        double r = 0, g = 0, b = 0;
        if (h < 60) { r = C; g = X; b = 0; }
        else if (h < 120) { r = X; g = C; b = 0; }
        else if (h < 180) { r = 0; g = C; b = X; }
        else if (h < 240) { r = 0; g = X; b = C; }
        else if (h < 300) { r = X; g = 0; b = C; }
        else { r = C; g = 0; b = X; }
        int ri = (int)Math.Round((r + m) * 255);
        int gi = (int)Math.Round((g + m) * 255);
        int bi = (int)Math.Round((b + m) * 255);
        return $"#{ri:X2}{gi:X2}{bi:X2}";
    }

    private static string Initials(string displayName)
