<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- References the real Web project specifically so PasswordHasher
         resolves through the app's own already-working dependency,
         rather than guessing at a standalone NuGet package name. -->
    <ProjectReference Include="..\ShanthiNikethan.EmployeeManagement.Web\ShanthiNikethan.EmployeeManagement.Web.csproj" />
  </ItemGroup>

</Project>
