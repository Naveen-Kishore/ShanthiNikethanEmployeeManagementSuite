@page "/leave"
@inject ILeaveService LeaveService
@inject IStaffProfileService StaffService

<h1>Leave Management</h1>

<div class="page-header">
    <button class="primary" @onclick="OpenAddDialog">
        <Icon Name="plus" Size="16" /> Add leave record
    </button>
</div>

<div class="filter-tabs" style="margin-bottom: 18px; width: fit-content;">
    <button class="filter-tab @(_viewMode == "week" ? "active" : "")" @onclick='() => SwitchView("week")'>This Week</button>
    <button class="filter-tab @(_viewMode == "month" ? "active" : "")" @onclick='() => SwitchView("month")'>This Month</button>
    <button class="filter-tab @(_viewMode == "year" ? "active" : "")" @onclick='() => SwitchView("year")'>This Year</button>
    <button class="filter-tab @(_viewMode == "employee" ? "active" : "")" @onclick='() => SwitchView("employee")'>By Employee</button>
</div>

@if (_viewMode == "week")
{
    <div class="toolbar">
        <input type="date" value="@_weekPickerDate.ToString("yyyy-MM-dd")" @onchange="OnWeekDatePicked" style="width: auto;" />
        <button class="secondary" @onclick="() => ShiftWeek(-7)"><Icon Name="chevron-down" Size="14" Style="transform: rotate(90deg);" /> Previous</button>
        <button class="secondary" @onclick="ResetToThisWeek">This week</button>
        <button class="secondary" @onclick="() => ShiftWeek(7)">Next <Icon Name="chevron-down" Size="14" Style="transform: rotate(-90deg);" /></button>
    </div>

    @if (_weekLoading)
    {
        <p class="stat-sub">Loading…</p>
    }
    else
    {
        <div style="display: flex; flex-direction: column; gap: 10px;">
            @foreach (var day in WeekDays)
            {
                var dayRecords = _weekRecords.Where(r => day >= r.StartDate && day <= r.EndDate).OrderBy(r => r.StaffDisplayName).ToList();
                var isToday = day == DateOnly.FromDateTime(DateTime.Today);
                <div class="calc-panel" style='@(isToday ? "border-color: var(--accent);" : "")'>
                    <div style='display: flex; align-items: baseline; gap: 8px; margin-bottom: @(dayRecords.Count > 0 ? "10px" : "0")'>
                        <strong>@day.ToString("dddd, dd MMM")</strong>
                        @if (isToday)
                        {
                            <span class="badge active">Today</span>
                        }
                        @if (dayRecords.Count == 0)
                        {
                            <span class="stat-sub">— nobody on leave</span>
                        }
                    </div>
                    @if (dayRecords.Count > 0)
                    {
                        <div style="display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 4px;">
                            @foreach (var r in dayRecords)
                            {
                                var (accent, bg, fg) = ChipColorFor(r.StaffId);
                                var photoPath = GetStaffPhotoPath(r.StaffId);
                                var chipTitle = string.IsNullOrWhiteSpace(r.Reason) ? $"{r.StaffDisplayName} · {r.Designation}" : $"{r.StaffDisplayName} · {r.Designation} — {r.Reason}";
                                <div @onclick="() => OpenEditDialog(r)" title="@chipTitle"
                                     style="background: @bg; color: @fg; border-left: 3px solid @accent; font-size: 12px; font-weight: 600; padding: 4px 10px 4px 8px; border-radius: 3px; cursor: pointer; display: flex; align-items: center; gap: 6px;">
                                    <div class="leave-chip-avatar" style="background: @accent;">
                                        @if (!string.IsNullOrEmpty(photoPath))
                                        {
                                            <img src="@($"/{photoPath}")" alt="" />
                                        }
                                        else
                                        {
                                            @Initials(r.StaffDisplayName)
                                        }
                                    </div>
                                    <span class="leave-chip-full">@r.StaffDisplayName</span>
                                </div>
                            }
                        </div>
                        @foreach (var r in dayRecords.Where(r => !string.IsNullOrWhiteSpace(r.SubstituteArrangementNotes)))
                        {
                            <div class="stat-sub" style="white-space: pre-line; padding-bottom: 4px;"><strong>@r.StaffDisplayName:</strong> @r.SubstituteArrangementNotes</div>
                        }
                    }
                </div>
            }
        </div>
    }
}
else if (_viewMode == "month")
{
    <div class="toolbar">
        <input type="date" value="@_monthPickerDate.ToString("yyyy-MM-dd")" @onchange="OnMonthDatePicked" style="width: auto;" />
        <button class="secondary" @onclick="() => ShiftSelectedMonth(-1)"><Icon Name="chevron-down" Size="14" Style="transform: rotate(90deg);" /> Previous</button>
        <button class="secondary" @onclick="() => ShiftSelectedMonth(1)">Next <Icon Name="chevron-down" Size="14" Style="transform: rotate(-90deg);" /></button>
        <select value="@_staffFilter" @onchange="OnStaffFilterChanged" style="width: auto;">
            <option value="">All staff</option>
            @foreach (var s in _activeStaff)
            {
                <option value="@s.Id">@s.DisplayName</option>
            }
        </select>
        <div class="filter-tabs">
            <button class="filter-tab @(_monthViewStyle == "calendar" ? "active" : "")" @onclick='() => _monthViewStyle = "calendar"'>Calendar</button>
            <button class="filter-tab @(_monthViewStyle == "table" ? "active" : "")" @onclick='() => _monthViewStyle = "table"'>Table</button>
        </div>
    </div>

    @if (!_monthLoading && _monthRecords.Count > 0)
    {
        <div class="calc-panel" style="margin-bottom: 16px;">
            <div class="calc-row total"><span>Total leave in @MonthViewSelectedMonthName</span><span class="val">@_monthRecords.Sum(r => r.DaysCount) day(s)</span></div>
        </div>
    }

    @if (_monthLoading)
    {
        <p class="stat-sub">Loading…</p>
    }
    else if (_monthRecords.Count == 0)
    {
        <div class="empty-state">
            <div class="icon"><Icon Name="calendar" Size="36" /></div>
            <p>No leave records for this month yet.</p>
        </div>
    }
    else if (_monthViewStyle == "calendar")
    {
        var monthParsed = DateOnly.TryParse(_selectedMonth + "-01", out var mp) ? mp : DateOnly.FromDateTime(DateTime.Today);
        var daysInMonth = DateTime.DaysInMonth(monthParsed.Year, monthParsed.Month);
        var leadingBlanks = (int)monthParsed.DayOfWeek;
        <div style="display: grid; grid-template-columns: repeat(7, 1fr); gap: 6px;">
            @foreach (var dow in new[] { "Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat" })
            {
                <div class="stat-sub" style="font-weight: 600; text-align: center; padding: 4px;">@dow</div>
            }
            @for (int i = 0; i < leadingBlanks; i++)
            {
                <div></div>
            }
            @for (int d = 1; d <= daysInMonth; d++)
            {
                var day = new DateOnly(monthParsed.Year, monthParsed.Month, d);
                var dayRecords = _monthRecords.Where(r => day >= r.StartDate && day <= r.EndDate).OrderBy(r => r.StaffDisplayName).ToList();
                var isToday = day == DateOnly.FromDateTime(DateTime.Today);
                <div style='min-height: 76px; border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 4px; @(isToday ? "border-color: var(--accent); border-width: 2px;" : "")'>
                    <div class="stat-sub" style='font-weight: @(isToday ? "700" : "500"); cursor: pointer; @(isToday ? "color: var(--accent);" : "")' @onclick="() => OpenDayDetail(day, dayRecords)">@d</div>
                    @foreach (var r in dayRecords.Take(3))
                    {
                        var (accent, bg, fg) = ChipColorFor(r.StaffId);
                        var photoPath = GetStaffPhotoPath(r.StaffId);
                        var chipTitle = string.IsNullOrWhiteSpace(r.Reason) ? r.StaffDisplayName : $"{r.StaffDisplayName} — {r.Reason}";
                        <div @onclick="() => OpenEditDialog(r)" title="@chipTitle"
                             style="background: @bg; color: @fg; border-left: 3px solid @accent; font-size: 10.5px; font-weight: 600; padding: 2px 5px 2px 4px; border-radius: 2px; margin-top: 3px; cursor: pointer; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; display: flex; align-items: center; gap: 4px;">
                            <div class="leave-chip-avatar leave-chip-avatar-sm" style="background: @accent;">
                                @if (!string.IsNullOrEmpty(photoPath))
                                {
                                    <img src="@($"/{photoPath}")" alt="" />
                                }
                                else
                                {
                                    @Initials(r.StaffDisplayName)
                                }
                            </div>
                            <span class="leave-chip-full">@r.StaffDisplayName</span>
                        </div>
                    }
                    @if (dayRecords.Count > 3)
                    {
                        <div class="stat-sub" style="font-size: 10px; margin-top: 2px; cursor: pointer; text-decoration: underline;" @onclick="() => OpenDayDetail(day, dayRecords)">+@(dayRecords.Count - 3) more</div>
                    }
                </div>
            }
        </div>
    }
    else
    {
        <div class="table-scroll">
        <table class="grid">
            <thead>
                <tr>
                    <th>Staff</th>
                    <th>Dates</th>
                    <th class="right">Days</th>
                    <th>Reason</th>
                    <th>Substitute arrangement</th>
                    <th style="width: 80px"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in _monthRecords)
                {
                    <tr>
                        <td>@r.StaffDisplayName <span class="stat-sub">@r.StaffCode</span></td>
                        <td>
                            @if (r.StartDate == r.EndDate)
                            {
                                @r.StartDate.ToString("dd MMM yyyy")
                            }
                            else
                            {
                                @($"{r.StartDate:dd MMM} – {r.EndDate:dd MMM yyyy}")
                            }
                        </td>
                        <td class="right">@r.DaysCount</td>
                        <td>@(string.IsNullOrWhiteSpace(r.Reason) ? "—" : r.Reason)</td>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(r.SubstituteArrangementNotes))
                            {
                                <span title="@r.SubstituteArrangementNotes" style="white-space: pre-line;">
                                    @(r.SubstituteArrangementNotes.Length > 60 ? r.SubstituteArrangementNotes[..60] + "…" : r.SubstituteArrangementNotes)
                                </span>
                            }
                            else
                            {
                                <span class="stat-sub">—</span>
                            }
                        </td>
                        <td class="right">
                            <button class="icon-btn" title="Edit" @onclick="() => OpenEditDialog(r)"><Icon Name="pencil" Size="14" /></button>
                            <button class="icon-btn" title="Delete" @onclick="() => OpenDeleteConfirm(r)"><Icon Name="trash-2" Size="14" /></button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    }
}
else if (_viewMode == "year")
{
    <div class="toolbar">
        <button class="secondary" @onclick="() => ShiftYear(-1)"><Icon Name="chevron-down" Size="14" Style="transform: rotate(90deg);" /></button>
        <select value="@_yearViewYear" @onchange="OnYearChanged" style="width: auto;">
            @for (int y = DateTime.Today.Year - 2; y <= DateTime.Today.Year + 1; y++)
            {
                <option value="@y">@y</option>
            }
        </select>
        <button class="secondary" @onclick="() => ShiftYear(1)"><Icon Name="chevron-down" Size="14" Style="transform: rotate(-90deg);" /></button>
    </div>

    @if (_yearLoading)
    {
        <p class="stat-sub">Loading…</p>
    }
    else
    {
        <div class="calc-panel" style="margin-bottom: 16px;">
            <div class="calc-row total"><span>Total leave in @_yearViewYear</span><span class="val">@_yearRecords.Sum(r => r.DaysCount) day(s)</span></div>
        </div>

        <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px;">
            @for (int m = 1; m <= 12; m++)
            {
                var monthDate = new DateOnly(_yearViewYear, m, 1);
                var daysInMonth = DateTime.DaysInMonth(_yearViewYear, m);
                var leadingBlanks = (int)monthDate.DayOfWeek;
                <div>
                    <div class="stat-sub" style="font-weight: 600; margin-bottom: 4px;">@monthDate.ToString("MMMM")</div>
                    <div style="display: grid; grid-template-columns: repeat(7, 1fr); gap: 2px; text-align: center; font-size: 10.5px;">
                        @for (int i = 0; i < leadingBlanks; i++)
                        {
                            <div></div>
                        }
                        @for (int d = 1; d <= daysInMonth; d++)
                        {
                            var day = new DateOnly(_yearViewYear, m, d);
                            var dayRecords = _yearRecords.Where(r => day >= r.StartDate && day <= r.EndDate).ToList();
                            <div @onclick="() => OpenDayDetail(day, dayRecords)"
                                 style='padding: 3px 0; border-radius: 3px; cursor: pointer; @(dayRecords.Count > 0 ? "background: var(--danger-soft); color: var(--danger); font-weight: 700;" : "")'>
                                @d
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
}
else
{
    <div class="toolbar">
        <select value="@_employeeViewStaffId" @onchange="OnEmployeeChanged" style="width: auto;">
            <option value="">— Select staff member —</option>
            @foreach (var s in _activeStaff)
            {
                <option value="@s.Id">@s.DisplayName (@s.StaffCode)</option>
            }
        </select>
        <div class="filter-tabs">
            <button class="filter-tab @(_employeeRangeMode == "month" ? "active" : "")" @onclick='() => SwitchEmployeeRangeMode("month")'>Month</button>
            <button class="filter-tab @(_employeeRangeMode == "year" ? "active" : "")" @onclick='() => SwitchEmployeeRangeMode("year")'>Whole year</button>
        </div>
        @if (_employeeRangeMode == "month")
        {
            <button class="secondary" @onclick="() => ShiftEmployeeMonth(-1)"><Icon Name="chevron-down" Size="14" Style="transform: rotate(90deg);" /></button>
            <MonthYearPicker Value="@_employeeViewMonth" ValueChanged="OnEmployeeMonthChanged" />
            <button class="secondary" @onclick="() => ShiftEmployeeMonth(1)"><Icon Name="chevron-down" Size="14" Style="transform: rotate(-90deg);" /></button>
        }
        else
        {
            <button class="secondary" @onclick="() => ShiftEmployeeYear(-1)"><Icon Name="chevron-down" Size="14" Style="transform: rotate(90deg);" /></button>
            <select value="@_employeeViewYear" @onchange="OnEmployeeYearChanged" style="width: auto;">
                @for (int y = DateTime.Today.Year - 2; y <= DateTime.Today.Year + 1; y++)
                {
                    <option value="@y">@y</option>
                }
            </select>
            <button class="secondary" @onclick="() => ShiftEmployeeYear(1)"><Icon Name="chevron-down" Size="14" Style="transform: rotate(-90deg);" /></button>
        }
    </div>

    @if (string.IsNullOrEmpty(_employeeViewStaffId))
    {
        <div class="empty-state">
            <div class="icon"><Icon Name="user" Size="36" /></div>
            <p>Pick a staff member to see their leave at a glance.</p>
        </div>
    }
    else if (_employeeLoading)
    {
        <p class="stat-sub">Loading…</p>
    }
    else if (_employeeRangeMode == "month")
    {
        <div class="calc-panel" style="margin-bottom: 16px;">
            <div class="calc-row total"><span>Total leave in @EmployeeSelectedMonthName</span><span class="val">@_employeeMonthRecords.Sum(r => r.DaysCount) day(s)</span></div>
        </div>

        <div style="display: grid; grid-template-columns: repeat(7, 1fr); gap: 4px; text-align: center; max-width: 420px;">
            @foreach (var dow in new[] { "Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat" })
            {
                <div class="stat-sub" style="font-weight: 600; padding: 4px;">@dow</div>
            }
            @for (int i = 0; i < EmployeeMonthLeadingBlanks; i++)
            {
                <div></div>
            }
            @foreach (var day in EmployeeMonthDays)
            {
                var dayRecord = _employeeMonthRecords.FirstOrDefault(r => day >= r.StartDate && day <= r.EndDate);
                var isToday = day == DateOnly.FromDateTime(DateTime.Today);
                var dayTitle = dayRecord == null ? null
                    : string.IsNullOrWhiteSpace(dayRecord.Reason)
                        ? $"On leave ({dayRecord.DaysCount} day(s) from {dayRecord.StartDate:dd MMM})"
                        : $"On leave — {dayRecord.Reason} ({dayRecord.DaysCount} day(s) from {dayRecord.StartDate:dd MMM})";
                <div title="@dayTitle"
                     style='padding: 8px 4px; border-radius: var(--radius-sm); @(dayRecord != null ? "background: var(--danger-soft); color: var(--danger); font-weight: 600;" : "background: var(--bg-surface-alt);") @(isToday ? "outline: 2px solid var(--accent); outline-offset: -2px;" : "")'>
                    @day.Day
                </div>
            }
        </div>
        <div class="stat-sub" style="margin-top: 10px;">Highlighted days indicate leave. Hover a highlighted day to see details.</div>
    }
    else
    {
        <div class="calc-panel" style="margin-bottom: 16px;">
            <div class="calc-row total"><span>Total leave in @_employeeViewYear</span><span class="val">@_employeeYearRecords.Sum(r => r.DaysCount) day(s)</span></div>
        </div>

        <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px;">
            @for (int m = 1; m <= 12; m++)
            {
                var monthDate = new DateOnly(_employeeViewYear, m, 1);
                var daysInMonth = DateTime.DaysInMonth(_employeeViewYear, m);
                var leadingBlanks = (int)monthDate.DayOfWeek;
                <div>
                    <div class="stat-sub" style="font-weight: 600; margin-bottom: 4px;">@monthDate.ToString("MMMM")</div>
                    <div style="display: grid; grid-template-columns: repeat(7, 1fr); gap: 2px; text-align: center; font-size: 10.5px;">
                        @for (int i = 0; i < leadingBlanks; i++)
                        {
                            <div></div>
                        }
                        @for (int d = 1; d <= daysInMonth; d++)
                        {
                            var day = new DateOnly(_employeeViewYear, m, d);
                            var yearDayRecord = _employeeYearRecords.FirstOrDefault(r => day >= r.StartDate && day <= r.EndDate);
                            var yearDayTitle = yearDayRecord == null ? null
                                : string.IsNullOrWhiteSpace(yearDayRecord.Reason)
                                    ? $"On leave ({yearDayRecord.DaysCount} day(s) from {yearDayRecord.StartDate:dd MMM})"
                                    : $"On leave — {yearDayRecord.Reason} ({yearDayRecord.DaysCount} day(s) from {yearDayRecord.StartDate:dd MMM})";
                            <div title="@yearDayTitle" style='padding: 3px 0; border-radius: 3px; @(yearDayRecord != null ? "background: var(--danger-soft); color: var(--danger); font-weight: 700;" : "")'>@d</div>
                        }
                    </div>
                </div>
            }
        </div>
    }
}

@if (_showFormDialog)
{
    <div class="modal-backdrop" @onclick="() => _showFormDialog = false">
        <div class="modal" @onclick:stopPropagation="true">
            <h2>
                @if (_editingId == null)
                {
                    <text>Add leave record</text>
                }
                else
                {
                    <text>@_editingStaffName</text>
                    <span class="stat-sub" style="font-weight: 400; margin-left: 6px;">@_editingStaffCode</span>
                }
            </h2>

            @if (_editingId == null)
            {
                <div class="form-row">
                    <label>Paste from WhatsApp (optional)</label>
                    <textarea rows="3" @bind="_pasteText" @bind:event="oninput" placeholder="Paste the leave notification message here, then click Parse — it'll fill in the fields below for you to check."></textarea>
                    <button class="secondary" style="margin-top: 6px;" @onclick="ParsePastedMessage" disabled="@(string.IsNullOrWhiteSpace(_pasteText))">
                        <Icon Name="check" Size="14" /> Parse & fill form
                    </button>
                    @if (_parseAttempted)
                    {
                        @if (_parsedStaffCandidates.Count == 0)
                        {
                            <div class="alert warning" style="margin-top: 8px;">
                                Couldn't confidently match a staff name@(string.IsNullOrEmpty(_parsedNameText) ? "" : $" from \"{_parsedNameText}\"") — pick the right person manually below.
                            </div>
                        }
                        else if (_parsedStaffCandidates.Count > 1)
                        {
                            <div class="alert warning" style="margin-top: 8px;">
                                Matched "@_parsedNameText" to more than one person — double-check the selection below is the right one.
                            </div>
                        }
                        else
                        {
                            <div class="stat-sub" style="margin-top: 6px;">Matched "@_parsedNameText" to @_parsedStaffCandidates[0].DisplayName — check the fields below before saving.</div>
                        }
                    }
                </div>
                <div style="border-top: 1px solid var(--border); margin: 4px 0 14px;"></div>

                <div class="form-row">
                    <label>Staff member *</label>
                    <select @bind="_formStaffId">
                        <option value="">— Select —</option>
                        @foreach (var s in _activeStaff)
                        {
                            <option value="@s.Id">@s.DisplayName (@s.StaffCode)</option>
                        }
                    </select>
                </div>
            }

            <div class="form-grid">
                <div class="form-row">
                    <label>Start date *</label>
                    <input type="date" @bind="_formStartDate" @bind:after="OnStartDateChanged" />
                </div>
                <div class="form-row">
                    <label>End date *</label>
                    <input type="date" @bind="_formEndDate" @bind:after="OnEndDateChanged" />
                </div>
            </div>

            <div class="form-row">
                <label>Number of days *</label>
                <input type="number" min="0.5" step="0.5" @bind="_formDaysCount" @bind:after="OnDaysCountChanged" style="max-width: 140px;" />
                <div class="stat-sub" style="margin-top: 4px;">Auto-filled from the date range — adjust if it should exclude a holiday or weekend.</div>
            </div>

            <div class="form-row">
                <label>Reason (optional)</label>
                <input type="text" @bind="_formReason" maxlength="200" placeholder="e.g. Family function, Medical" />
            </div>

            <div class="form-row">
                <label>Substitute arrangement (optional)</label>
                <textarea rows="5" @bind="_formSubstituteNotes" maxlength="1000"
                          placeholder="e.g.&#10;2nd Period: Anupriya miss&#10;4th Period: Gayathri miss&#10;Office Alternative: C. Abhinaya miss"></textarea>
            </div>

            @if (!string.IsNullOrEmpty(_formError))
            {
                <div class="alert danger">@_formError</div>
            }

            <div class="modal-actions" style="justify-content: @(_editingId != null ? "space-between" : "flex-end");">
                @if (_editingId != null)
                {
                    <button class="danger" @onclick="DeleteFromEditDialog">
                        <Icon Name="trash-2" Size="14" /> Delete
                    </button>
                }
                <div style="display: flex; gap: 10px;">
                    <button class="secondary" @onclick="() => _showFormDialog = false">Cancel</button>
                    <button class="primary" @onclick="SaveAsync" disabled="@_saving">
                        @(_saving ? "Saving…" : "Save")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (_deletingRecord != null)
{
    <div class="modal-backdrop" @onclick="() => _deletingRecord = null">
        <div class="modal" @onclick:stopPropagation="true">
            <h2>Delete this leave record?</h2>
            <div class="modal-body">
                @_deletingRecord.StaffDisplayName — @_deletingRecord.DaysCount day(s) from @_deletingRecord.StartDate.ToString("dd MMM yyyy"). This cannot be undone.
            </div>
            <div class="modal-actions">
                <button class="secondary" @onclick="() => _deletingRecord = null">Cancel</button>
                <button class="danger" @onclick="ConfirmDeleteAsync">Delete</button>
            </div>
        </div>
    </div>
}

@if (_dayDetailDate != null)
{
    <div class="modal-backdrop" @onclick="() => _dayDetailDate = null">
        <div class="modal" @onclick:stopPropagation="true">
            <h2>@_dayDetailDate.Value.ToString("dddd, dd MMMM yyyy")</h2>
            @if (_dayDetailRecords.Count == 0)
            {
                <p class="stat-sub">Nobody on leave this day.</p>
            }
            <div style="display: flex; flex-direction: column; gap: 8px;">
                @foreach (var r in _dayDetailRecords)
                {
                    var (accent, bg, fg) = ChipColorFor(r.StaffId);
                    <div @onclick="() => SelectDayDetailRecord(r)"
                         style="background: @bg; color: @fg; border-left: 3px solid @accent; border-radius: 3px; padding: 8px 10px; cursor: pointer;">
                        <div style="font-weight: 600;">@r.StaffDisplayName <span class="stat-sub" style="color: inherit; opacity: 0.75;">@r.StaffCode · @r.Designation</span></div>
                        @if (!string.IsNullOrWhiteSpace(r.Reason))
                        {
                            <div style="font-size: 12.5px;">@r.Reason</div>
                        }
                    </div>
                }
            </div>
            <div class="modal-actions">
                <button class="secondary" @onclick="() => _dayDetailDate = null">Close</button>
            </div>
        </div>
    </div>
}

@code {
