@* ==================== ROLE GROUP DETAIL DRAWER ==================== *@
@if (_drawerRoleGroup != null)
{
    <div class="drawer-backdrop" @onclick="() => _drawerRoleGroup = null"></div>
    <div class="drawer">
        <div class="drawer-header">
            <div class="drawer-identity">
                <div>
                    <h2 style="margin: 0;">@_drawerRoleGroup.Name</h2>
                    @if (_drawerRoleGroup.IsSystemDefined)
                    {
                        <span class="badge" style="margin-top: 4px;">Built-in</span>
                    }
                </div>
            </div>
            <button class="icon-btn" @onclick="() => _drawerRoleGroup = null"><Icon Name="x" /></button>
        </div>
        <div class="drawer-tabs">
            <button class="drawer-tab @(_rgTab == "basics" ? "active" : "")" @onclick='() => _rgTab = "basics"'>Basics</button>
            <button class="drawer-tab @(_rgTab == "roles" ? "active" : "")" @onclick='() => _rgTab = "roles"'>Roles</button>
            <button class="drawer-tab @(_rgTab == "members" ? "active" : "")" @onclick='() => _rgTab = "members"'>Members</button>
        </div>
        <div class="drawer-body">
            @if (_rgTab == "basics")
            {
                <div class="form-row">
                    <label>Name</label>
                    <input type="text" @bind="_rgName" disabled="@_drawerRoleGroup.IsSystemDefined" />
                </div>
                <div class="form-row">
                    <label>Description</label>
                    <input type="text" @bind="_rgDescription" disabled="@_drawerRoleGroup.IsSystemDefined" />
                </div>
                @if (_drawerRoleGroup.IsSystemDefined)
                {
                    <p class="stat-sub">Built-in role groups can't be renamed or removed, to keep at least one safety-net administrator role always available.</p>
                }
            }
            else if (_rgTab == "roles")
            {
                @if (_drawerRoleGroup.IsSystemDefined)
                {
                    <p class="stat-sub" style="margin-bottom: 12px;">Built-in role groups have a fixed set of roles.</p>
                }
                <div style="max-height: 340px; overflow-y: auto; border: 1px solid var(--border); border-radius: var(--radius-md); padding: 12px;">
                    @foreach (var category in PermissionCatalog.All.GroupBy(p => p.Category))
                    {
                        <div style="margin-bottom: 12px;">
                            <div class="stat-sub" style="font-weight: 600; margin-bottom: 6px;">@category.Key</div>
                            @foreach (var perm in category)
                            {
                                <label style="display: flex; align-items: center; gap: 8px; padding: 4px 0; cursor: pointer;">
                                    <input type="checkbox" checked="@_rgSelectedPermissions.Contains(perm.Key)" disabled="@_drawerRoleGroup.IsSystemDefined"
                                           @onchange="e => TogglePermission(_rgSelectedPermissions, perm.Key, (bool)(e.Value ?? false))" />
                                    <span>@perm.DisplayName</span>
                                </label>
                            }
                        </div>
                    }
                </div>
            }
            else if (_rgTab == "members")
            {
                var members = _userAccounts.Where(u => u.RoleGroupId == _drawerRoleGroup.Id).ToList();
                <div class="toolbar">
                    <button class="secondary" @onclick="() => { _drawerRoleGroup = null; OpenCreateUser(); }">Add member</button>
                </div>
                @if (members.Count == 0)
                {
                    <p class="stat-sub">No members in this role group.</p>
                }
                else
                {
                    <table class="grid">
                        <thead><tr><th>Name</th><th>Expires</th><th style="width: 90px"></th></tr></thead>
                        <tbody>
                            @foreach (var m in members)
                            {
                                <tr>
                                    <td>@m.DisplayName</td>
                                    <td class="stat-sub">@(UtcToIstDate(m.RoleGroupExpiresAtUtc)?.ToString("dd MMM yyyy") ?? "Never")</td>
                                    <td><button class="icon-btn" title="Edit member" @onclick="() => { _drawerRoleGroup = null; OpenUserDrawer(m); }"><Icon Name="pencil" Size="14" /></button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            }

            @if (!string.IsNullOrEmpty(_rgError))
            {
                <div class="alert danger" style="margin-top: 12px;">@_rgError</div>
            }
        </div>
        <div class="drawer-footer">
            @if (!_drawerRoleGroup.IsSystemDefined)
            {
                <button class="danger" @onclick="() => { _confirmDeleteRoleGroup = _drawerRoleGroup; _drawerRoleGroup = null; }">Delete</button>
            }
            <span style="flex: 1;"></span>
            <button class="secondary" @onclick="() => _drawerRoleGroup = null">Cancel</button>
            <button class="primary" @onclick="SaveRoleGroupDrawer" disabled="@_drawerRoleGroup.IsSystemDefined">Save</button>
        </div>
    </div>
}

@* ==================== DELETE ROLE GROUP CONFIRM ==================== *@
@if (_confirmDeleteRoleGroup != null)
{
    <div class="modal-backdrop" @onclick="() => _confirmDeleteRoleGroup = null">
        <div class="modal" @onclick:stopPropagation="true">
            <h2>Delete "@_confirmDeleteRoleGroup.Name"?</h2>
            <p class="modal-body">This can't be undone. If any members are still assigned to this role group, deletion will be blocked until they're reassigned.</p>
            @if (!string.IsNullOrEmpty(_rgError))
            {
                <div class="alert danger">@_rgError</div>
            }
            <div class="modal-actions">
                <button class="secondary" @onclick="() => _confirmDeleteRoleGroup = null">Cancel</button>
                <button class="primary" style="background: var(--danger); border-color: var(--danger);" @onclick="DeleteRoleGroupConfirmed">Delete permanently</button>
            </div>
        </div>
    </div>
}

@code {
