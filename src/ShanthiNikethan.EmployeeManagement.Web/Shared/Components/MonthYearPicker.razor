@* Native <input type="month"> pops up the browser's own calendar UI, which
   cannot be restyled via CSS under any circumstances — it's rendered
   outside the page's DOM entirely. This replaces it with two plain
   <select> elements that inherit our normal theming. *@

<div style="display: flex; gap: 8px;">
    <select value="@_month" @onchange="OnMonthChanged" style="flex: 2;">
        @for (int m = 1; m <= 12; m++)
        {
            var monthNum = m;
            <option value="@monthNum">@(new DateOnly(2000, monthNum, 1).ToString("MMMM"))</option>
        }
    </select>
    <select value="@_year" @onchange="OnYearChanged" style="flex: 1;">
        @for (int y = MinYear; y <= MaxYear; y++)
        {
            <option value="@y">@y</option>
        }
    </select>
</div>

@code {
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }

    private int MinYear => DateTime.Today.Year - 2;
    private int MaxYear => DateTime.Today.Year + 1;

    private int _month = DateTime.Today.Month;
    private int _year = DateTime.Today.Year;
    private string _lastParsedValue = "";

    protected override void OnParametersSet()
    {
        if (Value != _lastParsedValue && DateOnly.TryParse(Value + "-01", out var parsed))
        {
            _month = parsed.Month;
            _year = parsed.Year;
            _lastParsedValue = Value;
        }
    }

    private async Task OnMonthChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var m)) _month = m;
        await NotifyAsync();
    }

    private async Task OnYearChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var y)) _year = y;
        await NotifyAsync();
    }

    private async Task NotifyAsync()
    {
        var value = $"{_year:0000}-{_month:00}";
        _lastParsedValue = value;
        await ValueChanged.InvokeAsync(value);
    }
}
