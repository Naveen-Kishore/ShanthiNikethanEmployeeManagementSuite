                string.IsNullOrWhiteSpace(_drawerEntraObjectId) ? null : _drawerEntraObjectId.Trim(),
                _drawerLocalLoginEnabled,
                _drawerLocalLoginEnabled ? _drawerLocalUsername.Trim() : null);
            if (!string.IsNullOrEmpty(_drawerNewLocalPassword))
                await UserAccountService.SetLocalPasswordAsync(_drawerUser.Id, _drawerNewLocalPassword);
