    // day: saving used .ToUniversalTime() (server-timezone-dependent) while
    // the Users list row display used the raw stored value with zero
    // conversion at all - two inconsistent paths. This is the same fixed-
    // offset approach already proven correct for Audit Log timestamps.
    private static readonly TimeSpan IstOffset = TimeSpan.FromHours(5.5);

    /// <summary>Converts a date picked in an &lt;input type="date"&gt; (a calendar date the person means in IST) into the UTC instant for 23:59:59 on that IST calendar date - so access remains valid through the whole day intended, and the date survives the round trip through storage without shifting.</summary>
    private static DateTime? DatePickerToEndOfDayUtc(DateTime? pickedDate)
    {
        if (!pickedDate.HasValue) return null;
        var endOfDayIst = pickedDate.Value.Date.AddDays(1).AddSeconds(-1);
        return DateTime.SpecifyKind(endOfDayIst - IstOffset, DateTimeKind.Utc);
    }

    /// <summary>Reverses DatePickerToEndOfDayUtc - recovers the original IST calendar date from a stored UTC value, for both re-populating the date picker and for plain display.</summary>
    private static DateTime? UtcToIstDate(DateTime? utcValue)
    {
