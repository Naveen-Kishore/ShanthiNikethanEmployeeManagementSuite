@page "/admin/bootstrap-local-accounts"
@inject IUserAccountService UserAccountService
@inject ICurrentUser CurrentUser
@inject NavigationManager Nav

@if (!CurrentUser.HasPermission("Admin.ManageUsers"))
{
    <h1>Access denied</h1>
    <p class="stat-sub">You don't have permission to view this page.</p>
}
else
{
<h1>Local Account Setup</h1>
<p class="stat-sub" style="margin-bottom: 20px;">
    One-time setup for the two local fallback accounts (used only if Microsoft Entra ID sign-in is unavailable).
    You're seeing this page because you're already signed in via Entra ID — that's the only way to reach it.
</p>

@if (_loading)
{
    <p class="stat-sub">Loading…</p>
}
else
{
    @foreach (var account in _accounts)
    {
        <div class="calc-panel" style="margin-bottom: 16px; max-width: 480px;">
            <h3 style="margin: 0 0 4px 0;">@account.DisplayName</h3>
            <p class="stat-sub" style="margin: 0 0 14px 0;">
                Username: <strong>@account.LocalUsername</strong>
                @if (account.LocalLoginEnabled)
                {
                    <span class="badge active" style="margin-left: 6px;">Password set</span>
                }
                else
                {
                    <span class="badge pending" style="margin-left: 6px;">No password yet</span>
                }
            </p>

            <div class="form-row">
                <label>@(account.LocalLoginEnabled ? "Reset password" : "Set initial password")</label>
                <input type="password" @bind="_passwords[account.Id]" placeholder="At least 8 characters" />
            </div>
            <button class="primary" @onclick="() => SetPasswordAsync(account.Id)" disabled="@_saving">
                @(_saving ? "Saving…" : "Save password")
            </button>

            @if (_messages.TryGetValue(account.Id, out var message))
            {
                <div class="stat-sub" style="margin-top: 8px; color: var(--success);">@message</div>
            }
        </div>
    }
}
}

@code {
    private List<UserAccount> _accounts = new();
    private Dictionary<Guid, string> _passwords = new();
    private Dictionary<Guid, string> _messages = new();
    private bool _loading = true;
    private bool _saving;

    protected override async Task OnInitializedAsync()
    {
        var all = await UserAccountService.ListUsersAsync();
        _accounts = all.Where(u => u.LocalUsername != null).ToList();
        foreach (var a in _accounts) _passwords[a.Id] = "";
        _loading = false;
    }

    private async Task SetPasswordAsync(Guid userAccountId)
    {
        _messages.Remove(userAccountId);
        var password = _passwords.GetValueOrDefault(userAccountId, "");

        if (password.Length < 8)
        {
            _messages[userAccountId] = "Password must be at least 8 characters.";
            return;
        }

        _saving = true;
        try
        {
            await UserAccountService.SetLocalPasswordAsync(userAccountId, password);
            _passwords[userAccountId] = "";
            _messages[userAccountId] = "Password saved. This account can now sign in at /signin.";
            var all = await UserAccountService.ListUsersAsync();
            _accounts = all.Where(u => u.LocalUsername != null).ToList();
        }
        finally
        {
            _saving = false;
        }
    }
}
