<div class="masked-field @(Disabled ? "disabled" : "")">
    <input type="@(_shown ? "text" : "password")" value="@Value"
           @oninput="OnInput" readonly="@Disabled" placeholder="@Placeholder" />
    <button type="button" class="eye" @onclick="() => _shown = !_shown" tabindex="-1"
            title="@(_shown ? "Hide" : "Show")">
        <Icon Name="@(_shown ? "eye-off" : "eye")" />
    </button>
</div>

@code {
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public bool Disabled { get; set; }

    private bool _shown;

    private async Task OnInput(ChangeEventArgs e) => await ValueChanged.InvokeAsync(e.Value?.ToString());
}
