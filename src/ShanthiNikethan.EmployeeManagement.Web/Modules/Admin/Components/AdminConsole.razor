            await ReloadUsersAsync();
            _drawerUser = _userAccounts.FirstOrDefault(u => u.Id == _drawerUser.Id);
        }
        catch (InvalidOperationException ex)
        {
            _drawerError = ex.Message;
        }
        catch (Exception ex)
        {
            _drawerError = $"This couldn't be saved: {ex.Message}";
        }
    }

    private async Task ReactivateDrawerUser()
