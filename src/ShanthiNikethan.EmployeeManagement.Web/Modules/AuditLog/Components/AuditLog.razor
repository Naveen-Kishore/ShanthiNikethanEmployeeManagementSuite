@page "/audit-log"
@using ShanthiNikethan.EmployeeManagement.Core.Services
@inject IAuditService AuditService
@inject ICurrentUser CurrentUser

<h1>Audit Log</h1>

@if (!CurrentUser.HasPermission("Admin.ViewAuditLog"))
{
    <p class="stat-sub">You don't have permission to view this page.</p>
}
else
{
    <div class="card" style="padding: 18px 20px; margin-bottom: 18px;">
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 22px;">
            <div>
                <div class="stat-sub" style="font-weight: 600; margin-bottom: 8px;">Date Range</div>
                <label style="display: flex; align-items: center; gap: 8px; padding: 3px 0; cursor: pointer;">
                    <input type="radio" name="dateRange" style="width: auto;" checked="@(_dateRangePreset == "today")" @onchange='() => SetDateRangePreset("today")' />
                    <span>Today</span>
                </label>
                <label style="display: flex; align-items: center; gap: 8px; padding: 3px 0; cursor: pointer;">
                    <input type="radio" name="dateRange" style="width: auto;" checked="@(_dateRangePreset == "last7")" @onchange='() => SetDateRangePreset("last7")' />
                    <span>Last 7 days</span>
                </label>
                <label style="display: flex; align-items: center; gap: 8px; padding: 3px 0; cursor: pointer;">
                    <input type="radio" name="dateRange" style="width: auto;" checked="@(_dateRangePreset == "last30")" @onchange='() => SetDateRangePreset("last30")' />
                    <span>Last 30 days</span>
                </label>
                <label style="display: flex; align-items: center; gap: 8px; padding: 3px 0; cursor: pointer;">
                    <input type="radio" name="dateRange" style="width: auto;" checked="@(_dateRangePreset == "thismonth")" @onchange='() => SetDateRangePreset("thismonth")' />
                    <span>This month</span>
                </label>
                <label style="display: flex; align-items: center; gap: 8px; padding: 3px 0; cursor: pointer;">
                    <input type="radio" name="dateRange" style="width: auto;" checked="@(_dateRangePreset == "custom")" @onchange='() => SetDateRangePreset("custom")' />
                    <span>Custom range</span>
                </label>
                @if (_dateRangePreset == "custom")
                {
                    <div style="margin-top: 8px; display: flex; flex-direction: column; gap: 6px;">
                        <input type="date" @bind="_customFrom" style="font-size: 12.5px;" />
                        <input type="date" @bind="_customTo" style="font-size: 12.5px;" />
                    </div>
                }
            </div>

            <div>
                <div class="stat-sub" style="font-weight: 600; margin-bottom: 8px;">Module</div>
                @if (_availableModules.Count == 0)
                {
                    <div class="stat-sub">No activity recorded yet.</div>
                }
                @foreach (var m in _availableModules)
                {
                    <label style="display: flex; align-items: center; gap: 8px; padding: 3px 0; cursor: pointer;">
                        <input type="checkbox" style="width: auto;" checked="@_selectedModules.Contains(m)"
                               @onchange="e => ToggleFilterValue(_selectedModules, m, (bool)(e.Value ?? false))" />
                        <span>@m</span>
                    </label>
                }
            </div>

            <div>
                <div class="stat-sub" style="font-weight: 600; margin-bottom: 8px;">Entity Type</div>
                @foreach (var t in _availableEntityTypes)
                {
                    <label style="display: flex; align-items: center; gap: 8px; padding: 3px 0; cursor: pointer;">
                        <input type="checkbox" style="width: auto;" checked="@_selectedEntityTypes.Contains(t)"
                               @onchange="e => ToggleFilterValue(_selectedEntityTypes, t, (bool)(e.Value ?? false))" />
                        <span>@t</span>
                    </label>
                }
            </div>

            <div>
                <div class="stat-sub" style="font-weight: 600; margin-bottom: 8px;">Action</div>
                @foreach (var a in _availableActions)
                {
                    <label style="display: flex; align-items: center; gap: 8px; padding: 3px 0; cursor: pointer;">
                        <input type="checkbox" style="width: auto;" checked="@_selectedActions.Contains(a)"
                               @onchange="e => ToggleFilterValue(_selectedActions, a, (bool)(e.Value ?? false))" />
                        <span>@a</span>
                    </label>
                }
            </div>
        </div>

        <div class="form-grid" style="margin-top: 18px;">
            <div class="form-row">
                <label>Actor contains</label>
                <input type="text" @bind="_actorSearch" @bind:event="oninput" placeholder="Search by name…" />
            </div>
            <div class="form-row">
                <label>Keyword (searches everything — actor, entity ID, details, context)</label>
                <input type="text" @bind="_keyword" @bind:event="oninput" placeholder="Search details…" />
            </div>
        </div>

        <div class="toolbar" style="margin-top: 4px; margin-bottom: 0;">
            <button class="primary" @onclick="ApplyFiltersAsync"><Icon Name="check" Size="14" /> Apply filters</button>
            <button class="secondary" @onclick="ClearFiltersAsync">Clear all</button>
            @if (!_loading)
            {
                <span class="stat-sub">@_totalCount result(s)</span>
            }
        </div>
    </div>

    @if (_loading)
    {
        <p class="stat-sub">Loading…</p>
    }
    else if (_items.Count == 0)
    {
        <div class="empty-state">
            <div class="icon"><Icon Name="file-text" Size="36" /></div>
            <p>No activity matches these filters.</p>
        </div>
    }
    else
    {
        <div class="table-scroll">
        <table class="grid">
            <thead>
                <tr>
                    <th class="sortable" @onclick='() => SortByAsync("OccurredAtUtc")'>Date</th>
                    <th>Request ID</th>
                    <th class="sortable" @onclick='() => SortByAsync("ActorDisplayName")'>User</th>
                    <th class="sortable" @onclick='() => SortByAsync("RoleGroupAtTime")'>Role Group Assigned</th>
                    <th class="sortable" @onclick='() => SortByAsync("IsSuccess")'>Status</th>
                    <th>Sign-in error</th>
                    <th class="sortable" @onclick='() => SortByAsync("IpAddress")'>IP Address</th>
                    <th class="sortable" @onclick='() => SortByAsync("GeoLocation")'>Geo-location</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var entry in _items)
                {
                    <tr @onclick="() => OpenDrawer(entry)" style="cursor: pointer;">
                        <td>@ToIstDisplay(entry.OccurredAtUtc)</td>
                        <td class="stat-sub" title="@entry.RequestId">@TruncateMiddle(entry.RequestId)</td>
                        <td>@entry.ActorDisplayName</td>
                        <td class="stat-sub">@(entry.RoleGroupAtTime ?? "—")</td>
                        <td><span class="badge @(entry.IsSuccess ? "active" : "inactive")">@(entry.IsSuccess ? "Success" : "Failed")</span></td>
                        <td class="stat-sub">@(entry.SignInError ?? "—")</td>
                        <td class="stat-sub">@(entry.IpAddress ?? "—")</td>
                        <td class="stat-sub">@(entry.GeoLocation ?? "—")</td>
                    </tr>
                }
            </tbody>
        </table>
        </div>

        <div class="toolbar" style="justify-content: space-between; margin-top: 14px;">
            <span class="stat-sub">Showing @_rangeStart–@_rangeEnd of @_totalCount</span>
            <div style="display: flex; gap: 8px;">
                <button class="secondary" disabled="@(_page <= 1)" @onclick="() => ChangePageAsync(-1)">Previous</button>
                <button class="secondary" disabled="@(_rangeEnd >= _totalCount)" @onclick="() => ChangePageAsync(1)">Next</button>
            </div>
        </div>
    }
}

@* ==================== DETAIL DRAWER, WITH TABS ==================== *@
@if (_drawerEntry != null)
{
    <div class="drawer-backdrop" @onclick="() => _drawerEntry = null"></div>
    <div class="drawer">
        <div class="drawer-header">
            <div class="drawer-identity">
                <div>
                    <h2 style="margin: 0;">@_drawerEntry.Action</h2>
                    <span class="badge @(_drawerEntry.IsSuccess ? "active" : "inactive")" style="margin-top: 4px;">@(_drawerEntry.IsSuccess ? "Success" : "Failed")</span>
                </div>
            </div>
            <button class="icon-btn" @onclick="() => _drawerEntry = null"><Icon Name="x" /></button>
        </div>
        <div class="drawer-tabs">
            <button class="drawer-tab @(_drawerTab == "basic" ? "active" : "")" @onclick='() => _drawerTab = "basic"'>Basic Info</button>
            <button class="drawer-tab @(_drawerTab == "location" ? "active" : "")" @onclick='() => _drawerTab = "location"'>Location &amp; Device</button>
            <button class="drawer-tab @(_drawerTab == "auth" ? "active" : "")" @onclick='() => _drawerTab = "auth"'>Authentication Details</button>
        </div>
        <div class="drawer-body">
            @if (_drawerTab == "basic")
            {
                <div class="form-row"><label>When</label><div>@ToIstDisplay(_drawerEntry.OccurredAtUtc, full: true)</div></div>
                <div class="form-row"><label>User</label><div>@_drawerEntry.ActorDisplayName <span class="stat-sub">(@_drawerEntry.ActorObjectId)</span></div></div>
                <div class="form-row"><label>Role group at the time</label><div>@(_drawerEntry.RoleGroupAtTime ?? "—")</div></div>
                <div class="form-row"><label>Module / Entity</label><div>@_drawerEntry.Module / @_drawerEntry.EntityType@(string.IsNullOrEmpty(_drawerEntry.EntityId) ? "" : $" ({_drawerEntry.EntityId})")</div></div>
                @if (!string.IsNullOrEmpty(_drawerEntry.FieldName))
                {
                    <div class="form-row"><label>Field changed</label><div>@_drawerEntry.FieldName</div></div>
                }
                @if (_drawerEntry.OldValue != null || _drawerEntry.NewValue != null)
                {
                    <div class="form-grid">
                        <div class="form-row"><label>Old value</label><div class="stat-sub" style="white-space: pre-line;">@(_drawerEntry.OldValue ?? "—")</div></div>
                        <div class="form-row"><label>New value</label><div class="stat-sub" style="white-space: pre-line;">@(_drawerEntry.NewValue ?? "—")</div></div>
                    </div>
                }
                @if (!string.IsNullOrEmpty(_drawerEntry.Context))
                {
                    <div class="form-row"><label>Context</label><div class="stat-sub" style="white-space: pre-line;">@_drawerEntry.Context</div></div>
                }
            }
            else if (_drawerTab == "location")
            {
                <div class="form-row"><label>IP address</label><div>@(_drawerEntry.IpAddress ?? "—")</div></div>
                <div class="form-row"><label>Geo-location</label><div>@(_drawerEntry.GeoLocation ?? "—")</div></div>
                <div class="form-row"><label>Device</label><div>@(_drawerEntry.DeviceInfo ?? "—")</div></div>
                <div class="form-row"><label>Browser</label><div>@(_drawerEntry.BrowserInfo ?? "—")</div></div>
                @if (!string.IsNullOrEmpty(_drawerEntry.IpAddress) && _drawerEntry.GeoLocation == "Unknown")
                {
                    <p class="stat-sub" style="margin-top: 8px;">
                        The geo-location lookup didn't resolve for this sign-in — this can happen if the lookup
                        service was briefly unreachable. It never blocks or delays sign-in itself; it's a
                        best-effort enrichment, not a required step.
                    </p>
                }
            }
            else
            {
                <div class="form-row"><label>Provider</label><div>@(_drawerEntry.Provider ?? "—")</div></div>
                <div class="form-row">
                    <label>Status</label>
                    <div><span class="badge @(_drawerEntry.IsSuccess ? "active" : "inactive")">@(_drawerEntry.IsSuccess ? "Success" : "Failed")</span></div>
                </div>
                @if (!string.IsNullOrEmpty(_drawerEntry.SignInError))
                {
                    <div class="form-row"><label>Sign-in error</label><div>@_drawerEntry.SignInError</div></div>
                }
                <div class="form-row"><label>Request ID</label><div class="stat-sub" style="word-break: break-all;">@(_drawerEntry.RequestId ?? "—")</div></div>
            }
        </div>
        <div class="drawer-footer">
            <span style="flex: 1;"></span>
            <button class="secondary" @onclick="() => _drawerEntry = null">Close</button>
        </div>
    </div>
}

@code {
    private bool _loading = true;
    private List<AuditLogEntry> _items = new();
    private int _totalCount;
    private int _page = 1;
    private const int PageSize = 50;
    private string _sortBy = "OccurredAtUtc";
    private bool _sortDescending = true;

    private string _dateRangePreset = "last7";
    private DateTime _customFrom = DateTime.Today.AddDays(-7);
    private DateTime _customTo = DateTime.Today;

    private List<string> _availableModules = new();
    private List<string> _availableEntityTypes = new();
    private List<string> _availableActions = new();
    private HashSet<string> _selectedModules = new();
    private HashSet<string> _selectedEntityTypes = new();
    private HashSet<string> _selectedActions = new();
    private string _actorSearch = "";
    private string _keyword = "";

    private AuditLogEntry? _drawerEntry;
    private string _drawerTab = "basic";

    private int _rangeStart => _totalCount == 0 ? 0 : (_page - 1) * PageSize + 1;
    private int _rangeEnd => Math.Min(_page * PageSize, _totalCount);

    protected override async Task OnInitializedAsync()
    {
        if (!CurrentUser.HasPermission("Admin.ViewAuditLog")) return;

        _availableModules = await AuditService.GetDistinctModulesAsync();
        _availableEntityTypes = await AuditService.GetDistinctEntityTypesAsync();
        _availableActions = await AuditService.GetDistinctActionsAsync();

        await LoadAsync();
    }

    // Shared toggle helper, same pattern used for permission checkboxes elsewhere in Admin Console.
    private void ToggleFilterValue(HashSet<string> selected, string value, bool isChecked)
    {
        if (isChecked) selected.Add(value);
        else selected.Remove(value);
    }

    private void SetDateRangePreset(string preset) => _dateRangePreset = preset;

    private (DateTime? From, DateTime? To) ResolveDateRange()
    {
        var nowUtc = DateTime.UtcNow;
        return _dateRangePreset switch
        {
            "today" => (DateTime.UtcNow.Date, (DateTime?)null),
            "last7" => (nowUtc.AddDays(-7), (DateTime?)null),
            "last30" => (nowUtc.AddDays(-30), (DateTime?)null),
            "thismonth" => (new DateTime(nowUtc.Year, nowUtc.Month, 1, 0, 0, 0, DateTimeKind.Utc), (DateTime?)null),
            "custom" => (DateTime.SpecifyKind(_customFrom, DateTimeKind.Utc), DateTime.SpecifyKind(_customTo.AddDays(1), DateTimeKind.Utc)),
            _ => (null, null)
        };
    }

    private async Task ApplyFiltersAsync()
    {
        _page = 1;
        await LoadAsync();
    }

    private async Task ClearFiltersAsync()
    {
        _dateRangePreset = "last7";
        _selectedModules.Clear();
        _selectedEntityTypes.Clear();
        _selectedActions.Clear();
        _actorSearch = "";
        _keyword = "";
        _page = 1;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        StateHasChanged();

        var (from, to) = ResolveDateRange();
        var filter = new AuditLogSearchFilter
        {
            FromUtc = from,
            ToUtc = to,
            Modules = _selectedModules.ToList(),
            EntityTypes = _selectedEntityTypes.ToList(),
            Actions = _selectedActions.ToList(),
            ActorSearch = string.IsNullOrWhiteSpace(_actorSearch) ? null : _actorSearch,
            Keyword = string.IsNullOrWhiteSpace(_keyword) ? null : _keyword,
            SortBy = _sortBy,
            SortDescending = _sortDescending,
            Page = _page,
            PageSize = PageSize
        };

        (_items, _totalCount) = await AuditService.SearchAsync(filter);
        _loading = false;
    }

    private async Task ChangePageAsync(int delta)
    {
        _page += delta;
        await LoadAsync();
    }

    private async Task SortByAsync(string column)
    {
        if (_sortBy == column) _sortDescending = !_sortDescending;
        else { _sortBy = column; _sortDescending = true; }
        _page = 1;
        await LoadAsync();
    }

    // Explicit +5:30 offset rather than relying on the server's configured
    // timezone (ToLocalTime() depends on that, and cloud VMs often default
    // to UTC unless someone's explicitly changed it - not reliable). India
    // doesn't observe DST, so a fixed offset is safe here without needing
    // IANA timezone database lookups.
    private static readonly TimeSpan IstOffset = TimeSpan.FromHours(5.5);

    private static string ToIstDisplay(DateTime utc, bool full = false)
    {
        var ist = DateTime.SpecifyKind(utc, DateTimeKind.Utc).Add(IstOffset);
        var format = full ? "dddd, dd MMM yyyy, hh:mm:ss tt" : "dd MMM yyyy, hh:mm:ss tt";
        return $"{ist.ToString(format)} IST";
    }

    private void OpenDrawer(AuditLogEntry entry)
    {
        _drawerEntry = entry;
        _drawerTab = "basic"; // always start on the same tab, regardless of which row/tab was open last
    }

    // ASP.NET Core's TraceIdentifier is long and not meaningful to read in
    // full inline in a table cell - shown truncated here with the complete
    // value available via the title tooltip and in full inside the drawer.
    private static string TruncateMiddle(string? s)
    {
        if (string.IsNullOrEmpty(s)) return "—";
        if (s.Length <= 16) return s;
        return $"{s[..8]}…{s[^6..]}";
    }
}
